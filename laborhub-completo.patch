+# Copie para .env (cp .env.example .env) e troque as senhas. O .env não vai para o Git.
+
+# Portas no computador. Use API_BIND=0.0.0.0 apenas para testar em um celular físico na mesma rede.
+API_BIND=127.0.0.1
+API_PORT=8080
+PHPMYADMIN_PORT=8081
+MAILPIT_PORT=8025
+MYSQL_PORT=3307
+
+# MySQL. O nome do banco é definido em database/init/01-laborhub.sql; não altere sem editar o dump.
+DB_NAME=FluuterLaborHub
+DB_USER=laborhub
+DB_PASSWORD=troque-esta-senha
+MYSQL_ROOT_PASSWORD=troque-esta-senha-root
+
+# Segredo HMAC dos códigos de recuperação, com 32+ caracteres. Gere com: openssl rand -hex 32
+APP_SECRET=
+
+# SMTP. Padrão: Mailpit local (emails visíveis em http://localhost:8025).
+# Servidor real: SMTP_SECURITY=starttls (porta 587) ou ssl (porta 465), com usuário e senha.
+SMTP_HOST=mailpit
+SMTP_PORT=1025
+SMTP_SECURITY=none
+SMTP_USER=
+SMTP_PASSWORD=
+SMTP_FROM=no-reply@laborhub.local
