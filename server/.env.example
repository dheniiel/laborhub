# Carregue estas variáveis no ambiente do processo; o servidor não lê .env automaticamente.
RESET_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=usuario-smtp
SMTP_PASSWORD=senha-de-aplicativo
SMTP_FROM=no-reply@example.com
DATABASE_PATH=laborhub.sqlite
HOST=127.0.0.1
PORT=8080
